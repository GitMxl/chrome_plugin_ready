{
  "manifest_version": 3,
  "name": "全部图片屏蔽",
  "version": "1.4.0",
  "minimum_chrome_version": "145",
  "description": "支持普通和严格两档图片屏蔽、网站规则、标签页临时放行与单张图片查看。",
  "permissions": ["storage", "declarativeNetRequest", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "全部图片屏蔽", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["settings.js", "reveal.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
